@model DoctorWepApp.Models.Doctor

<h2 class="mb-4">Doctor Details</h2>

<div class="card p-4 shadow-sm">
    <p><strong>Id:</strong> @Model.DoctorId</p>
    <p><strong>Name:</strong> @Model.FullName</p>
    <p><strong>Email:</strong> @Model.DoctorEmail</p>
    <p><strong>Phone:</strong> @Model.DoctorPhoneNo</p>
    <p><strong>Experience:</strong> @Model.YearsOfExperience</p>
    <p><strong>Fee:</strong> ₹@Model.ConsultationFee</p>
    <p><strong>Specialisation:</strong> @Model.Specialisation</p>

    <a href="@Url.Action("Index", "Doctor")" class="btn btn-secondary mt-3">Back</a>
</div>

