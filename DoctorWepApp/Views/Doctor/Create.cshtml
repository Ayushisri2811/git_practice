
@model DoctorWepApp.Models.Doctor

<h2 class="mb-4">Add Doctor</h2>

@using (Html.BeginForm())
{
    <div class="card p-4 shadow-sm">

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="mb-3">
            <label>Name</label>
            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })
        </div>

        <div class="mb-3">
            <label>Email</label>
            @Html.TextBoxFor(m => m.DoctorEmail, new { @class = "form-control" })
        </div>

        <div class="mb-3">
            <label>Phone</label>
            @Html.TextBoxFor(m => m.DoctorPhoneNo, new { @class = "form-control" })
        </div>

        <div class="mb-3">
            <label>Experience</label>
            @Html.TextBoxFor(m => m.YearsOfExperience, new { @class = "form-control" })
        </div>

        <div class="mb-3">
            <label>Fee</label>
            @Html.TextBoxFor(m => m.ConsultationFee, new { @class = "form-control" })
        </div>

        <div class="mb-3">
            <label>Specialisation</label>
            @Html.DropDownListFor(m => m.Specialisation,
                new SelectList(Enum.GetValues(typeof(DoctorWepApp.Models.SpecialisationType))),
                "Select Specialisation",
                new { @class = "form-select" })
        </div>

        <button type="submit" class="btn btn-success">Save</button>

        <a href="@Url.Action("Index", "Doctor")" class="btn btn-secondary">Cancel</a>
    </div>
}


