
@model DoctorWepApp.Models.Doctor

<h2 class="mb-4">Delete Doctor</h2>

<div class="card p-4 shadow-sm">
    <h4>Are you sure you want to delete this doctor?</h4>

    <p><strong>@Model.FullName</strong></p>

    @using (Html.BeginForm("Delete", "Doctor", FormMethod.Post))
    {
        @Html.HiddenFor(m => m.DoctorId)

        <button type="submit" class="btn btn-danger">Delete</button>

        <a href="@Url.Action("Index", "Doctor")" class="btn btn-secondary">Cancel</a>
    }
</div>

