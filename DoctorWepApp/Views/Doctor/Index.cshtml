
@model List<DoctorWepApp.Models.Doctor>

<h2 class="mb-4">Doctor List</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">
        @TempData["Message"]
    </div>
}

<a href="@Url.Action("Create")" class="btn btn-primary mb-3">
    Add Doctor
</a>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Specialisation</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var doc in Model)
        {
            <tr>
                <td>@doc.DoctorId</td>
                <td>@doc.FullName</td>
                <td>@doc.Specialisation</td>
                <td>
                    <a href="@Url.Action("Details", new { id = doc.DoctorId })" class="btn btn-info btn-sm">Details</a>
                    <a href="@Url.Action("Edit", new { id = doc.DoctorId })" class="btn btn-warning btn-sm">Edit</a>
                    <a href="@Url.Action("Delete", new { id = doc.DoctorId })" class="btn btn-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
