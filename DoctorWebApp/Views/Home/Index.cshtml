        transition: 0.3s;
        color: #2c3e50;
        background: #ffffff;
        border: 1px solid #e6eef5;
        text-align: center;
    }

        .card-box:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 25px rgba(0,0,0,0.08);
        }

        .card-box h2 {
            margin: 0;
            font-size: 22px;
        }

        .card-box .btn {
            width: 120px; /* ✅ uniform button width */
            border-radius: 8px;
            font-weight: 500;
            padding: 6px 0;
        }

    /* Card Colors */
    .patient {
        border-left: 6px solid #7fb3d5;
    }

    .doctor {
        border-left: 6px solid #82e0aa;
    }

    .appointment {
        border-left: 6px solid #f7c59f;
    }

    .record {
        border-left: 6px solid #f1948a;
    }

    /* HEADER */
    .dashboard-header {
        background: linear-gradient(135deg, #aed6f1, #d5f5e3);
        color: #2c3e50;
        border-radius: 15px;
        padding: 40px;
    }
</style>

<div class="container-fluid" style="padding:30px;">

