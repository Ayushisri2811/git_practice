@model DoctorWebApp.Models.HealthRecord

<div class="container">

    <h2>Create Health Record</h2>

    @using (Html.BeginForm())
    {
        @Html.ValidationSummary(false, "", new { @class = "text-danger" })

        @Html.HiddenFor(x => x.RecordId)

        <div class="form-group">
            <label>Patient Name</label>
            @Html.TextBoxFor(x => x.PatientName,
                new { @class = "form-control" })

            @Html.ValidationMessageFor(x => x.PatientName,
                "",
                new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label>Doctor Name</label>
            @Html.TextBoxFor(x => x.DoctorName,
                new { @class = "form-control" })

            @Html.ValidationMessageFor(x => x.DoctorName,
                "",
                new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label>Visit Date</label>

            @Html.TextBoxFor(x => x.VisitDate,
                "{0:yyyy-MM-dd}",
                new
                {
                    @class = "form-control",
                    type = "date"
                })

            @Html.ValidationMessageFor(x => x.VisitDate,
                "",
                new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label>Diagnosis</label>

            @Html.TextAreaFor(x => x.Diagnosis,
                new
                {
                    @class = "form-control",
                    rows = 3
                })

            @Html.ValidationMessageFor(x => x.Diagnosis,
                "",
                new { @class = "text-danger" })
        </div>

        <div class="form-group">
            <label>Prescription</label>

            @Html.TextAreaFor(x => x.Prescription,
                new
                {
                    @class = "form-control",
                    rows = 3
                })
        </div>

        <div class="form-group">
            <label>Notes</label>

            @Html.TextAreaFor(x => x.Notes,
                new
                {
                    @class = "form-control",
                    rows = 3
                })
        </div>

        <button type="submit" class="btn btn-success">
            Save
        </button>

        @Html.ActionLink("Back",
            "Index",
            null,
            new { @class = "btn btn-secondary" })
    }

</div>

@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}