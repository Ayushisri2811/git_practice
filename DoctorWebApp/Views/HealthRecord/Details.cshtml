
@model DoctorWebApp.Models.HealthRecord

<div class="container">
    <h2>Health Record Details</h2>

    <div class="card p-3">
        <p><b>Patient:</b> @Model.PatientName</p>
        <p><b>Doctor:</b> @Model.DoctorName</p>
        <p><b>Visit Date:</b> @Model.VisitDate.ToShortDateString()</p>
        <p><b>Diagnosis:</b> @Model.Diagnosis</p>
        <p><b>Prescription:</b> @Model.Prescription</p>
        <p><b>Notes:</b> @Model.Notes</p>
    </div>

    <br />

    @Html.ActionLink("Back", "Index", null, new { @class = "btn btn-secondary" })
</div>
