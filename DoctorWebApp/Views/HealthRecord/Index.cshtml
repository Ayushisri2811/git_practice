
@model IEnumerable<DoctorWebApp.Models.HealthRecord>

<div class="container">
    <h2>Health Records</h2>

    <p>
        @Html.ActionLink("Add Record", "Create", null,
        new { @class = "btn btn-primary" })
    </p>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Patient</th>
                <th>Doctor</th>
                <th>Visit Date</th>
                <th>Diagnosis</th>
                <th width="220"></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.PatientName</td>
                    <td>@item.DoctorName</td>
                    <td>@item.VisitDate.ToShortDateString()</td>
                    <td>@item.Diagnosis</td>
                    <td>
                        @Html.ActionLink("Edit", "Edit",
                            new { id = item.RecordId },
                            new { @class = "btn btn-warning btn-sm" })

                        @Html.ActionLink("Details", "Details",
                            new { id = item.RecordId },
                            new { @class = "btn btn-info btn-sm" })

                        @Html.ActionLink("Delete", "Delete",
                            new { id = item.RecordId },
                            new { @class = "btn btn-danger btn-sm" })
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
