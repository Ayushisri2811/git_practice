@model DoctorWebApp.Models.Appointment
@using DoctorWebApp.Models

<style>
    body {
        background: #f5f8fa;
    }

    .header-box {
        background: linear-gradient(135deg, #aed6f1, #d5f5e3);
        padding: 20px;
        border-radius: 15px;
        text-align: center;
        margin-bottom: 20px;
    }

    .form-box {
        background: white;
        padding: 25px;
        border-radius: 15px;
        border: 1px solid #e6eef5;
    }

    .form-group {
        margin-bottom: 15px;
    }
</style>

<div class="container mt-4">

    <div class="header-box">
        <h2>📅 Book Appointment</h2>
    </div>

    <div class="form-box">

        @using (Html.BeginForm())
        {
            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

            <!-- ✅ Patient ID -->
            <div class="form-group">
                <label>Patient ID</label>
                @Html.TextBoxFor(m => m.PatientId, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.PatientId, "", new { @class = "text-danger" })
            </div>

            <!-- ✅ Doctor Dropdown -->
            <div class="form-group">
                <label>Select Doctor</label>

                @Html.DropDownListFor(m => m.DoctorId,
                    new SelectList(ViewBag.Doctors, "DoctorId", "FullName"),
                    "-- Select Doctor --",
                    new { @class = "form-control" })

                @Html.ValidationMessageFor(m => m.DoctorId, "", new { @class = "text-danger" })
            </div>

            <!-- ✅ Date -->
            <div class="form-group">
                <label>Date</label>
                @Html.TextBoxFor(m => m.ScheduledDate,
                    "{0:yyyy-MM-dd}",
                    new
                    {
                        type = "date",
                        @class = "form-control",
                        min = DateTime.Now.ToString("yyyy-MM-dd")
                    })
                @Html.ValidationMessageFor(m => m.ScheduledDate, "", new { @class = "text-danger" })
            </div>

            <!-- ✅ Time Slot -->
            <div class="form-group">
                <label>Time Slot</label>

                @Html.DropDownListFor(m => m.TimeSlot,
                    new SelectList(new List<string>
                    {
                        "09:00 AM",
                        "10:00 AM",
                        "11:00 AM",
                        "12:00 PM",
                        "02:00 PM",
                        "03:00 PM",
                        "04:00 PM"
                    }),
                    "-- Select Time --",
                    new { @class = "form-control" })

                @Html.ValidationMessageFor(m => m.TimeSlot, "", new { @class = "text-danger" })
            </div>

            <!-- ✅ Submit -->
            <button class="btn btn-success mt-3">Book Appointment</button>
        }

    </div>
</div>

<!-- ✅ ✅ CLIENT-SIDE VALIDATION (extra safety for UX) -->
<script>
    document.querySelector("form").addEventListener("submit", function (event) {

        const dateValue = document.querySelector("[name='ScheduledDate']").value;
        const timeValue = document.querySelector("[name='TimeSlot']").value;

        if (dateValue && timeValue) {

            const selectedDateTime = new Date(dateValue + " " + timeValue);
            const now = new Date();

            if (selectedDateTime <= now) {
                alert("❌ Cannot select past date and time");
                event.preventDefault();
            }
        }
    });
</script>