@model IEnumerable<DoctorWebApp.Models.Appointment>

<div class="container">

    <h2>Appointments</h2>

    <p>
        @Html.ActionLink("Book Appointment",
            "Create",
            null,
            new { @class = "btn btn-primary" })
    </p>

    <table class="table table-bordered table-striped">

        <thead>
            <tr>
                <th>Patient</th>
                <th>Doctor</th>
                <th>Date</th>
                <th>Time Slot</th>
                <th>Status</th>
                <th width="220"></th>
            </tr>
        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.PatientName</td>
                    <td>@item.DoctorName</td>
                    <td>@item.ScheduledDate.ToShortDateString()</td>
                    <td>@item.TimeSlot</td>
                    <td>@item.Status</td>

                    <td>
                        @Html.ActionLink("Edit", "Edit",
                            new { id = item.AppointmentId },
                            new { @class = "btn btn-warning btn-sm" })

                        @Html.ActionLink("Details", "Details",
                            new { id = item.AppointmentId },
                            new { @class = "btn btn-info btn-sm" })

                        @Html.ActionLink("Delete", "Delete",
                            new { id = item.AppointmentId },
                            new { @class = "btn btn-danger btn-sm" })
                    </td>
                </tr>
            }

        </tbody>

    </table>

</div>

