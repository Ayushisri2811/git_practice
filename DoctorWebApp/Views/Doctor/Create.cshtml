@model DoctorWebApp.Models.Doctor

<div class="container">
    <h2>Doctor Form</h2>

    @using (Html.BeginForm())
    {
        @Html.HiddenFor(x => x.DoctorId)

        <div class="form-group">
            <label>Doctor Name</label>
            @Html.TextBoxFor(x => x.FullName,
                new { @class = "form-control" })
        </div>

        <div class="form-group">
            <label>Specialisation</label>
            @Html.EnumDropDownListFor(x => x.Specialisation,
                new { @class = "form-control" })
        </div>

        <div class="form-group">
            <label>Phone Number</label>
            @Html.TextBoxFor(x => x.DoctorPhoneNo,
                new { @class = "form-control" })
        </div>

        <div class="form-group">
            <label>Email</label>
            @Html.TextBoxFor(x => x.DoctorEmail,
                new { @class = "form-control" })
        </div>

        <div class="form-group">
            <label>Experience (Years)</label>
            @Html.TextBoxFor(x => x.YearsOfExperience,
                new { @class = "form-control", type = "number" })
        </div>

        <div class="form-group">
            <label>Consultation Fee</label>
            @Html.TextBoxFor(x => x.ConsultationFee,
                new { @class = "form-control", type = "number" })
        </div>

        <div class="checkbox">
            <label>
                @Html.CheckBoxFor(x => x.IsActive)
                Active Doctor
            </label>
        </div>

        <button type="submit" class="btn btn-success">
            Save
        </button>

        @Html.ActionLink("Back", "Index", null,
            new { @class = "btn btn-default" })
    }
</div>

