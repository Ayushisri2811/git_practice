@model IEnumerable<DoctorWebApp.Models.Doctor>

<div class="container">
    <h2>Doctors</h2>

    <p>
        @Html.ActionLink("Add Doctor", "Create", null,
        new { @class = "btn btn-primary" })
    </p>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Specialisation</th>
                <th>Experience</th>
                <th>Fee</th>
                <th>Status</th>
                <th width="220"></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.FullName</td>
                    <td>@item.Specialisation</td>
                    <td>@item.YearsOfExperience Years</td>
                    <td>₹ @item.ConsultationFee</td>
                    <td>
                        @(item.IsActive ? "Active" : "Inactive")
                    </td>
                    <td>
                        @Html.ActionLink("Edit", "Edit",
                        new { id = item.DoctorId },
                        new { @class = "btn btn-warning btn-sm" })

                        @Html.ActionLink("Details", "Details",
                        new { id = item.DoctorId },
                        new { @class = "btn btn-info btn-sm" })

                        @Html.ActionLink("Delete", "Delete",
                        new { id = item.DoctorId },
                        new { @class = "btn btn-danger btn-sm" })
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

