@model DoctorWebApp.Models.Doctor

<style>
    body {
        background: #f5f8fa;
    }

    .form-box {
        background: white;
        padding: 30px;
        border-radius: 15px;
        border: 1px solid #e6eef5;
    }

    .header-box {
        background: linear-gradient(135deg, #aed6f1, #d5f5e3);
        padding: 25px;
        border-radius: 15px;
        margin-bottom: 20px;
        text-align: center;
    }

    .form-group {
        margin-bottom: 15px;
    }

    .btn-group {
        display: flex;
        gap: 10px;
    }
</style>

<div class="container mt-4">

    <div class="header-box">
        <h2>✏️ Edit Doctor</h2>
    </div>

    <div class="form-box">

        @using (Html.BeginForm())
        {
            @Html.HiddenFor(m => m.DoctorId)

            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

            <!-- ✅ Doctor ID (Read-only) -->
            <div class="form-group">
                <label>Doctor ID</label>
                <input class="form-control" value="@Model.DoctorId" readonly />
            </div>

            <!-- ✅ Name -->
            <div class="form-group">
                @Html.LabelFor(m => m.FullName)
                @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
            </div>

            <!-- ✅ Specialisation -->
            <div class="form-group">
                @Html.LabelFor(m => m.Specialisation)
                @Html.EnumDropDownListFor(m => m.Specialisation,
                    new { @class = "form-control" })
            </div>

            <!-- ✅ Experience -->
            <div class="form-group">
                @Html.LabelFor(m => m.YearsOfExperience)
                @Html.TextBoxFor(m => m.YearsOfExperience, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.YearsOfExperience, "", new { @class = "text-danger" })
            </div>

            <!-- ✅ Phone -->
            <div class="form-group">
                @Html.LabelFor(m => m.DoctorPhoneNo)
                @Html.TextBoxFor(m => m.DoctorPhoneNo, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.DoctorPhoneNo, "", new { @class = "text-danger" })
            </div>

            <!-- ✅ Email -->
            <div class="form-group">
                @Html.LabelFor(m => m.DoctorEmail)
                @Html.TextBoxFor(m => m.DoctorEmail, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.DoctorEmail, "", new { @class = "text-danger" })
            </div>

            <!-- ✅ Fee -->
            <div class="form-group">
                @Html.LabelFor(m => m.ConsultationFee)
                @Html.TextBoxFor(m => m.ConsultationFee, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.ConsultationFee, "", new { @class = "text-danger" })
            </div>

            <!-- ✅ BUTTONS -->
            <div class="btn-group mt-3">
                <button type="submit" class="btn btn-primary">
                    Update
                </button>

                @Html.ActionLink("Cancel", "Index", null,
                    new { @class = "btn btn-secondary" })
            </div>
        }

    </div>

</div>
