@model IEnumerable<DoctorWebApp.Models.Patient>

<div class="container">
    <div class="row">
        <div class="col-md-12">

            <h2>Patients</h2>

            <p>
                @Html.ActionLink("Add Patient", "Create",
                null,
                new { @class = "btn btn-primary" })
            </p>

            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>DOB</th>
                        <th>Gender</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.FullName</td>
                            <td>@item.DateOfBirth.ToShortDateString()</td>
                            <td>@item.Gender</td>
                            <td>@item.PhoneNumber</td>
                            <td>@item.Email</td>
                            <td>
                                @Html.ActionLink("Edit", "Edit", new { id = item.PatientId },
                                    new { @class = "btn btn-warning btn-sm" })

                                @Html.ActionLink("Details", "Details", new { id = item.PatientId },
                                    new { @class = "btn btn-info btn-sm" })

                                @Html.ActionLink("Delete", "Delete", new { id = item.PatientId },
                                    new { @class = "btn btn-danger btn-sm" })
                            </td>
                        </tr>
                    }

                </tbody>
            </table>

        </div>
    </div>
</div>

