@model IEnumerable<DoctorWebApp.Models.Patient>

<style>
    body {
        background: #f5f8fa;
    }

    .header-box {
        background: linear-gradient(135deg, #aed6f1, #d5f5e3);
        padding: 25px;
        border-radius: 15px;
        text-align: center;
        margin-bottom: 20px;
    }

    .table-box {
        background: white;
        padding: 20px;
        border-radius: 15px;
        border: 1px solid #e6eef5;
    }

    .filter-box {
        display: none;
        background: #fff;
        padding: 15px;
        margin-top: 10px;
        border-radius: 10px;
        border: 1px solid #ddd;
    }
</style>

<script>
    function toggleFilter() {
        var x = document.getElementById("filterBox");
        x.style.display = (x.style.display === "none") ? "block" : "none";
    }
</script>

<div class="container mt-4">

    <div class="header-box">
        <h2>👤 Patient List</h2>
    </div>

    <div class="table-box">

        <!-- ✅ SEARCH + FILTER -->
        <div class="d-flex justify-content-between align-items-center mb-3">

            <!-- ✅ SEARCH -->
            <form method="get" class="d-flex gap-2">
                <input type="text" name="searchTerm"
                       value="@ViewBag.SearchTerm"
                       placeholder="Search by ID / Name"
                       class="form-control"
                       style="width:250px;" />

                <button class="btn btn-primary text-white">Search</button>
            </form>

            <!-- ✅ FILTER BUTTON -->
            <button onclick="toggleFilter()" class="btn btn-info text-white">
                Filter / Sort
            </button>

        </div>

        <!-- ✅ FILTER BOX -->
        <div id="filterBox" class="filter-box">
            <form method="get">

                <input type="hidden" name="searchTerm" value="@ViewBag.SearchTerm" />

                <div class="mb-2">
                    <label>Insurance</label>
                    <select name="insuranceFilter" class="form-control">
                        <option value="">All</option>
                        <option value="WithInsurance">With Insurance</option>
                        <option value="WithoutInsurance">Without Insurance</option>
                    </select>
                </div>

                <div class="mb-2">
                    <label>Sort</label>
                    <select name="sortOrder" class="form-control">
                        <option value="asc">Ascending</option>
                        <option value="desc">Descending</option>
                    </select>
                </div>

                <div class="text-end">
                    <button class="btn btn-success mt-2">Apply</button>
                </div>

            </form>
        </div>

        <!-- ✅ REGISTER BUTTON -->
        <div class="mb-3 mt-2">
            <a href="/Patient/Create" class="btn btn-success">
                + Register Patient
            </a>
        </div>

        <!-- ✅ TABLE -->
        <table class="table table-bordered">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>DOB</th>
                <th>Email</th>
                <th>Insurance</th>
                <th>Actions</th>
            </tr>

            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">
                        No patients found
                    </td>
                </tr>
            }

            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.PatientId</td>
                    <td>@item.FullName</td>
                    <td>@item.DateOfBirth.ToShortDateString()</td>
                    <td>@item.Email</td>
                    <td>@(string.IsNullOrEmpty(item.InsuranceId) ? "No" : "Yes")</td>

                    <!-- ✅ CLEAN ACTION BUTTONS -->
                    <td>
                        <div class="d-flex gap-2">
                            @Html.ActionLink("View", "Details", new { id = item.PatientId }, new { @class = "btn btn-sm btn-primary" })
                            @Html.ActionLink("Edit", "Edit", new { id = item.PatientId }, new { @class = "btn btn-sm btn-warning text-white" })
                            @Html.ActionLink("Deactivate", "Deactivate", new { id = item.PatientId }, new { @class = "btn btn-sm btn-danger" })
                        </div>
                    </td>
                </tr>
            }

        </table>
    </div>
</div>