@model DoctorWebApp.Models.Patient

<div class="container mt-4">

    <h2>📝 Register Patient</h2>

    @using (Html.BeginForm())
    {
        @Html.ValidationSummary(true)

        <label>Patient ID</label>
        <input class="form-control" value="Auto-generated" readonly />

        @Html.LabelFor(m => m.FullName)
        @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.FullName)

        @Html.LabelFor(m => m.DateOfBirth)
        @Html.TextBoxFor(m => m.DateOfBirth, "{0:yyyy-MM-dd}",
            new { @type = "date", @class = "form-control" })
        @Html.ValidationMessageFor(m => m.DateOfBirth)

        @Html.LabelFor(m => m.Email)
        @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Email)

        @Html.LabelFor(m => m.PhoneNumber)
        @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.PhoneNumber)

        @Html.LabelFor(m => m.Gender)
        @Html.EnumDropDownListFor(m => m.Gender, new { @class = "form-control" })

        @Html.LabelFor(m => m.InsuranceId)
        @Html.TextBoxFor(m => m.InsuranceId, new { @class = "form-control" })

        <button class="btn btn-info text-white mt-3">Register</button>
    }

</div>
