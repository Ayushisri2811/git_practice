@model DoctorWebApp.Models.Patient

<style>
    body {
        background: #f5f8fa;
    }

    .profile-box {
        background: white;
        padding: 30px;
        border-radius: 15px;
        border-left: 6px solid #7fb3d5;
    }

    .header-box {
        background: linear-gradient(135deg, #aed6f1, #d5f5e3);
        padding: 25px;
        border-radius: 15px;
        margin-bottom: 20px;
    }
</style>

<div class="container mt-4">

    <div class="header-box text-center">
        <h2>👤 Patient Profile</h2>
    </div>

    <div class="profile-box">
        <p><strong>Name:</strong> @Model.FullName</p>
        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>Phone:</strong> @Model.PhoneNumber</p>
        <p><strong>Appointments:</strong> @Model.AppointmentCount</p>
        <p><strong>Status:</strong> @(Model.IsActive ? "Active" : "Inactive")</p>
    </div>

</div>