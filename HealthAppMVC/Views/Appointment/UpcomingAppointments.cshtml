@section Scripts {
    <script>
        $(document).ready(function () {

            $(".appointment-action").click(function (e) {

                var message = $(this).data("message");

                if (!confirm(message)) {
                    e.preventDefault();
                }

            });

        });
    </script>
}
@model IEnumerable<SharedDto.AppointmentDtos.AppointmentDto>

@{
    ViewBag.Title = "Upcoming Appointments";

    var appointmentsWithRecords =
        ViewBag.AppointmentsWithRecords as List<int> ?? new List<int>();
}

<div class="container upcoming-container">

    <div class="page-header-section">
        <h1 class="page-title">Upcoming Appointments</h1>
        <p class="page-subtitle">View and manage upcoming doctor appointments.</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success custom-alert">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger custom-alert">
            @TempData["Error"]
        </div>
    }

    <div class="search-card">

        @using (Html.BeginForm("UpcomingAppointments", "Appointment", FormMethod.Get))
        {
            <div class="row">

                <div class="col-md-8">
                    <label class="search-label">Search Doctor</label>

                    <input type="text"
                           id="doctorName"
                           name="doctorName"
                           class="form-control custom-input"
                           placeholder="Search doctor by name"
                           value="@ViewBag.DoctorName" />
                </div>

                <div class="col-md-4 search-actions">
                    <button type="submit"
                            class="btn custom-btn search-btn">
                        Search
                    </button>

                    @Html.ActionLink(
                        "Back to Doctors",
                        "Index",
                        "Doctor",
                        null,
                        new { @class = "btn custom-btn cancel-btn" })
                </div>

            </div>
        }

    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row appointment-card-row">

            @foreach (var item in Model)
            {
                var status = item.Status == null ? "" : item.Status.Trim();
                var hasHealthRecord =
                    appointmentsWithRecords.Contains(item.AppointmentId);

                <div class="col-md-4 appointment-card-wrapper">

                    <div class="appointment-card">

                        <div class="appointment-card-header">
                            <div class="appointment-icon">
                                📅
                            </div>

                            <div>
                                <h3 class="doctor-name">
                                    @item.DoctorName
                                </h3>

                                <span class="appointment-id-badge">
                                    Appointment ID: @item.AppointmentId
                                </span>
                            </div>
                        </div>

                        <div class="appointment-details">

                            <div class="detail-item">
                                <span class="detail-label">Patient</span>
                                <span class="detail-value">@item.PatientName</span>
                            </div>

                            <div class="detail-item">
                                <span class="detail-label">Date</span>
                                <span class="detail-value">@item.ScheduledDate.ToString("dd MMM yyyy")</span>
                            </div>

                            <div class="detail-item">
                                <span class="detail-label">Time Slot</span>
                                <span class="detail-value">@item.TimeSlot</span>
                            </div>

                            <div class="detail-item">
                                <span class="detail-label">Status</span>

                                <span class="detail-value">
                                    @if (status.Equals("Pending", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="status-badge pending-badge">Pending</span>
                                    }
                                    else if (status.Equals("Confirmed", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="status-badge confirmed-badge">Confirmed</span>
                                    }
                                    else if (status.Equals("Completed", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="status-badge completed-badge">Completed</span>
                                    }
                                    else if (status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="status-badge cancelled-badge">Cancelled</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge pending-badge">@item.Status</span>
                                    }
                                </span>
                            </div>

                        </div>

                        <div class="card-actions">

                            @if (status.Equals("Pending", StringComparison.OrdinalIgnoreCase))
                            {
                                <a href="@Url.Action("Confirm", "Appointment", new { id = item.AppointmentId })"
                                   class="btn custom-btn confirm-btn appointment-action"
                                   data-message="Are you sure you want to confirm this appointment?">
                                    Confirm
                                </a>

                                <a href="@Url.Action("Cancel", "Appointment", new { id = item.AppointmentId })"
                                   class="btn custom-btn cancel-action-btn appointment-action"
                                   data-message="Are you sure you want to cancel this appointment?">
                                    Cancel
                                </a>
                            }

                            @if (status.Equals("Confirmed", StringComparison.OrdinalIgnoreCase)
                                && !hasHealthRecord)
                            {
                                <a href="@Url.Action("Create", "HealthRecord", new { appointmentId = item.AppointmentId })"
                                   class="btn custom-btn health-record-btn">
                                    Add Health Record
                                </a>
                            }

                            @if (status.Equals("Confirmed", StringComparison.OrdinalIgnoreCase))
                            {
                                <a href="@Url.Action("Complete", "Appointment", new { id = item.AppointmentId })"
                                   class="btn custom-btn complete-btn appointment-action"
                                   data-message="Are you sure you want to complete this appointment?">
                                    Complete
                                </a>
                            }

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">📅</div>
            <h3>No Upcoming Appointments Found</h3>
            <p>No upcoming appointments are available for the selected doctor.</p>
        </div>
    }

</div>

