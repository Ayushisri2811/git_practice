@using System
@using System.Linq
@model IEnumerable<SharedDto.AppointmentDtos.AppointmentDto>

@{
    ViewBag.Title = "Appointments";
}

<div class="container appointment-container">

    <div class="page-header-section">
        <h1 class="page-title">Appointment Management</h1>
        <p class="page-subtitle">View, confirm, complete and manage appointments.</p>
    </div>

    <div class="action-bar">
        @Html.ActionLink(
            "+ Book Appointment",
            "Create",
            "Appointment",
            null,
            new { @class = "btn custom-btn appointment-btn" })
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success custom-alert">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger custom-alert">
            @TempData["Error"]
        </div>
    }

    <div class="card table-card">
        <div class="card-body">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                   <table class="table custom-table">

                       <thead>
                           <tr>
                               <th>Patient</th>
                               <th>Doctor</th>
                               <th>Date</th>
                               <th>Time Slot</th>
                               <th>Status</th>
                           </tr>
                       </thead>

                       <tbody>
                           @foreach (var item in Model)
                           {
                               var status = item.Status == null
                                   ? "Pending"
                                   : item.Status.Trim();

                               <tr>
                                   <td>@item.PatientName</td>

                                   <td>@item.DoctorName</td>

                                   <td>
                                       @item.ScheduledDate.ToString("dd MMM yyyy")
                                   </td>

                                   <td>@item.TimeSlot</td>

                                   <td>

                                       @if (status.Equals("Pending", StringComparison.OrdinalIgnoreCase))
                                       {
                                           <span class="status-badge pending-badge">
                                               Pending
                                           </span>
                                       }
                                       else if (status.Equals("Confirmed", StringComparison.OrdinalIgnoreCase))
                                       {
                                           <span class="status-badge confirmed-badge">
                                               Confirmed
                                           </span>
                                       }
                                       else if (status.Equals("Completed", StringComparison.OrdinalIgnoreCase))
                                       {
                                           <span class="status-badge completed-badge">
                                               Completed
                                           </span>
                                       }
                                       else
                                       {
                                           <span class="status-badge pending-badge">
                                               Pending
                                           </span>
                                       }

                                   </td>
                               </tr>
                           }
                       </tbody>

                   </table>

                </div>
            }
            else
            {
                <div class="empty-state">

                    <div class="empty-icon">
                        📅
                    </div>

                    <h3>No Appointments Found</h3>

                    <p>Start by booking your first appointment.</p>

                    @Html.ActionLink(
                        "Book Appointment",
                        "Create",
                        "Appointment",
                        null,
                        new { @class = "btn custom-btn appointment-btn" })

                </div>
            }

        </div>
    </div>

    <div class="back-link">
        @Html.ActionLink(
            "← Back to Home",
            "Index",
            "Home",
            null,
            null)
    </div>

</div>

<style>
    body {
        background: #f4fbfc;
    }

    .appointment-container {
        margin-top: 45px;
        margin-bottom: 50px;
    }

    .page-header-section {
        text-align: center;
        margin-bottom: 30px;
    }

    .page-title {
        font-weight: 800;
        color: #123c4a;
        font-size: 2.4rem;
        margin-bottom: 8px;
    }

    .page-subtitle {
        color: #6c7f86;
        font-size: 1rem;
    }

    .action-bar {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-bottom: 22px;
        flex-wrap: wrap;
    }

    .custom-alert {
        border-radius: 14px;
        margin-bottom: 20px;
    }

    .table-card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
        background: #ffffff;
    }

        .table-card .card-body {
            padding: 25px;
        }

    .custom-table {
        margin-bottom: 0;
    }

        .custom-table thead {
            background: #fff4e6;
            color: #123c4a;
        }

        .custom-table th {
            border-bottom: none;
            padding: 14px;
            font-weight: 700;
        }

        .custom-table td {
            padding: 14px;
            vertical-align: middle;
            color: #37545c;
        }

        .custom-table tbody tr:hover {
            background: #f7fcfd;
        }

    .custom-btn {
        padding: 10px 20px;
        border-radius: 25px;
        font-weight: 600;
        color: #ffffff;
        border: none;
        text-decoration: none;
        display: inline-block;
    }

        .custom-btn:hover,
        .custom-btn:focus {
            color: #ffffff;
            text-decoration: none;
        }

    .appointment-btn {
        background-color: #f5b041;
    }

        .appointment-btn:hover {
            background-color: #e09a2d;
        }

    .status-badge {
        padding: 6px 12px;
        border-radius: 15px;
        font-weight: 700;
        font-size: 0.85rem;
        display: inline-block;
    }

    .pending-badge {
        background: #fff4e6;
        color: #e09a2d;
    }

    .confirmed-badge {
        background: #e6f2ff;
        color: #357aa3;
    }

    .completed-badge {
        background: #e8f8f3;
        color: #2d8c72;
    }

    .cancelled-badge {
        background: #fdecea;
        color: #c9302c;
    }

    .confirm-btn {
        background: #4a90c2;
        color: white;
        border-radius: 18px;
        padding: 6px 14px;
        border: none;
        margin: 3px;
    }

        .confirm-btn:hover,
        .confirm-btn:focus {
            background: #357aa3;
            color: white;
            text-decoration: none;
        }

    .complete-btn {
        background: #38a889;
        color: white;
        border-radius: 18px;
        padding: 6px 14px;
        border: none;
        margin: 3px;
    }

        .complete-btn:hover,
        .complete-btn:focus {
            background: #2d8c72;
            color: white;
            text-decoration: none;
        }

    .cancel-action-btn {
        background: #d9534f;
        color: white;
        border-radius: 18px;
        padding: 6px 14px;
        border: none;
        margin: 3px;
    }

        .cancel-action-btn:hover,
        .cancel-action-btn:focus {
            background: #c9302c;
            color: white;
            text-decoration: none;
        }

    .empty-state {
        text-align: center;
        padding: 50px 20px;
        color: #6c7f86;
    }

    .empty-icon {
        font-size: 60px;
        margin-bottom: 15px;
    }

    .empty-state h3 {
        color: #123c4a;
        font-weight: 700;
    }

    .back-link {
        margin-top: 25px;
        text-align: center;
    }

        .back-link a {
            color: #f5b041;
            font-weight: 600;
            text-decoration: none;
        }

            .back-link a:hover {
                text-decoration: underline;
            }

    @@media (max-width: 768px) {
        .page-title {
            font-size: 2rem;
        }

        .action-bar {
            justify-content: center;
        }

        .custom-table {
            font-size: 0.9rem;
        }
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {

            $(".appointment-action").click(function (e) {

                var message = $(this).data("message");

                if (!confirm(message)) {
                    e.preventDefault();
                }

            });

        });
    </script>
}