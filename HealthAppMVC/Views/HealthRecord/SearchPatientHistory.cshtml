@model IEnumerable<SharedDto.HealthRecordDtos.HealthRecordDto>

@{
    ViewBag.Title = "Patient Health History";
}

<style>
    body {
        background: #f5f8fa;
    }

    .header-box {
        background: linear-gradient(135deg, #aed6f1, #d5f5e3);
        padding: 20px;
        border-radius: 15px;
        text-align: center;
        margin-bottom: 20px;
    }

    .table-box {
        background: white;
        padding: 20px;
        border-radius: 15px;
        border: 1px solid #e6eef5;
    }
</style>

<div class="container mt-4">

    <!-- ✅ Header -->
    <div class="header-box">
        <h2>📋 Patient Health History</h2>
    </div>

    <!-- ✅ Search Section -->
    <div class="form-group mb-3">
        <label>Patient Name</label>

        <input type="text" id="patientName" class="form-control" />

        <input type="hidden" id="patientId" />

        <span id="patientError" class="text-danger"></span>
    </div>

    <button id="btnHistory" class="btn btn-primary">
        View History
    </button>

    <a href="@Url.Action("DoctorServices", "Home")"
       class="btn btn-secondary ms-2">
        Back
    </a>

    <!-- ✅ Table Section -->
    <div class="table-box mt-4">

        <table class="table table-bordered">
            <thead class="table-light">
                <tr>
                    <th>Visit Date</th>
                    <th>Doctor</th>
                    <th>Diagnosis</th>
                    <th>Prescription</th>
                    <th>Notes</th>
                </tr>
            </thead>

            <tbody>

                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">
                            No health records available
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.VisitDate.ToString("dd-MM-yyyy")</td>
                            <td>@item.DoctorName</td>
                            <td>@item.Diagnosis</td>
                            <td>@item.Prescription</td>
                            <td>@item.Notes</td>
                        </tr>
                    }
                }

            </tbody>
        </table>

    </div>

</div>

@section Scripts{
    <script>
    $(function () {

        // ✅ AutoComplete
        $("#patientName").autocomplete({
            source: '@Url.Action("SearchPatientNames", "HealthRecord")',
            minLength: 1,
            select: function (event, ui) {
                $("#patientId").val(ui.item.value);
            }
        });

        // ✅ Search button
        $("#btnHistory").click(function () {

            var id = $("#patientId").val();
            var patientName = $("#patientName").val();

            if (!patientName) {
                $("#patientError").text("Please enter patient name.");
                return;
            }

            if (!id || id === "0") {
                $("#patientError").text("No patient available.");
                return;
            }

            $("#patientError").text("");

            window.location =
                '/HealthRecord/SearchPatientHistory?patientId=' + id;
        });

    });
    </script>
}