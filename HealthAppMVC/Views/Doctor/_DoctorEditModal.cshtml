@model SharedDto.DoctorDtos.CreateDoctorDto

@{
    var doctorId = ViewBag.DoctorId;
    var specialisations = ViewBag.Specialisations as string[] ?? new string[] { };
}

<!-- ✅ HEADER -->
<div class="modal-header custom-modal-header">

    <h4 class="modal-title">
        📝 Edit Doctor
    </h4>

    <button type="button" class="close-doctor-modal">
        &times;
    </button>

</div>

@using (Html.BeginForm("Edit", "Doctor",
    new { id = doctorId },
    FormMethod.Post,
    new { id = "doctorEditForm" }))
{
    @Html.AntiForgeryToken()

    <!-- ✅ BODY -->
    <div class="modal-body">

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <!-- ✅ FORM GRID -->
        <div class="form-grid">

            <div class="form-group">
                <label>Full Name</label>
                @Html.TextBoxFor(m => m.FullName,
                    new { @class = "form-control custom-input", placeholder = "Enter doctor name" })
            </div>

            <div class="form-group">
                <label>Specialisation</label>
                @Html.DropDownListFor(
                    m => m.Specialisation,
                    new SelectList(specialisations, Model?.Specialisation),
                    "-- Select Specialisation --",
                    new { @class = "form-control custom-input" })
            </div>

            <div class="form-group">
                <label>Phone</label>
                @Html.TextBoxFor(m => m.DoctorPhoneNo,
                    new
                    {
                        @class = "form-control custom-input",
                        placeholder = "Enter phone number",
                        maxlength = "10"
                    })
            </div>

            <div class="form-group">
                <label>Email</label>
                @Html.TextBoxFor(m => m.DoctorEmail,
                    new
                    {
                        @class = "form-control custom-input",
                        type = "email",
                        placeholder = "Enter email"
                    })
            </div>

            <div class="form-group">
                <label>Experience</label>
                @Html.TextBoxFor(m => m.YearsOfExperience,
                    new
                    {
                        @class = "form-control custom-input",
                        type = "number",
                        min = "0"
                    })
            </div>

            <div class="form-group">
                <label>Consultation Fee (₹)</label>
                @Html.TextBoxFor(m => m.ConsultationFee,
                    new
                    {
                        @class = "form-control custom-input",
                        type = "number",
                        step = "0.01"
                    })
            </div>

        </div>

    </div>

    <!-- ✅ FOOTER -->
    <div class="modal-footer">

        <button type="submit"
                class="btn custom-btn doctor-btn">
            ✅ Update
        </button>

        <button type="button"
                class="btn custom-btn cancel-btn close-doctor-modal">
            Cancel
        </button>

    </div>
}