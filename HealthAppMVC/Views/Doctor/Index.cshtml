@model IEnumerable<SharedDto.DoctorDtos.DoctorDto>

@{
    ViewBag.Title = "Doctor Management";
}

<div class="container mt-4">

    <!-- ✅ HEADER -->
    <div class="text-center mb-4">
        <h1 class="fw-bold text-dark">Doctor Management</h1>
        <p class="text-muted">
            View, add, edit and manage doctor records.
        </p>
    </div>

    <!-- ✅ ACTION BUTTONS -->
    <div class="d-flex justify-content-end mb-4">

        <a href="/Doctor/Create" class="btn btn-success rounded-pill me-2 px-4">
            + Add New Doctor
        </a>

        <!-- ✅ GLOBAL HISTORY BUTTON -->
        <button class="btn btn-secondary rounded-pill px-4"
                onclick="openHealthHistory()">
            View Patient History
        </button>

    </div>

    <!-- ✅ CARD TABLE -->
    <div class="card shadow-lg border-0 rounded-4 p-4">

        <table class="table align-middle">

            <thead class="text-dark">
                <tr>
                    <th>Name</th>
                    <th>Specialisation</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Experience</th>
                    <th>Fee</th>
                    <th>Status</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var doctor in Model)
                {
                    <tr>

                        <td>@doctor.FullName</td>
                        <td>@doctor.Specialisation</td>
                        <td>@doctor.DoctorPhoneNo</td>
                        <td>@doctor.DoctorEmail</td>
                        <td>@doctor.YearsOfExperience</td>
                        <td>₹ @doctor.ConsultationFee</td>

                        <td>
                            @if (doctor.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactive</span>
                            }
                        </td>

                        <td class="text-center">

                            <!-- ✅ VIEW -->
                            <button class="btn btn-primary rounded-pill px-3"
                                    onclick="openDoctorPopup(@doctor.DoctorId)">
                                View
                            </button>

                            <!-- ✅ EDIT -->
                            <button class="btn btn-success rounded-pill px-3 ms-1"
                                    onclick="openEditPopup(@doctor.DoctorId)">
                                Edit
                            </button>

                            <!-- ✅ ADD HEALTH RECORD -->
                            <button class="btn btn-dark rounded-pill px-3 ms-1"
                                    onclick="openAddHealthRecord()">
                                Add Record
                            </button>

                            <!-- ✅ ACTIVATE / DEACTIVATE -->
                            <button class="btn btn-danger rounded-pill px-3 ms-1"
                                    onclick="confirmStatusChange(@doctor.DoctorId, '@doctor.IsActive')">
                                @(doctor.IsActive ? "Deactivate" : "Activate")
                            </button>

                        </td>

                    </tr>
                }
            </tbody>

        </table>

    </div>

</div>

<!-- ✅ COMMON MODAL -->
<div class="modal fade" id="commonModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content rounded-4" id="modalContent">
            Loading...
        </div>
    </div>
</div>

<!-- ✅ CONFIRM MODAL -->
<div class="modal fade" id="confirmModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content rounded-4">

            <div class="modal-header bg-warning">
                <h5 class="modal-title">Warning</h5>
            </div>

            <div class="modal-body text-center"></div>

            <div class="modal-footer justify-content-center">
                <button class="btn btn-secondary rounded-pill px-4"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <a id="confirmBtn" class="btn btn-danger rounded-pill px-4">
                    Yes
                </a>
            </div>

        </div>
    </div>
</div>

<!-- ✅ SCRIPTS -->
<script>

    // ✅ VIEW
    function openDoctorPopup(id) {

        var modal = new bootstrap.Modal(document.getElementById('commonModal'));
        modal.show();

        fetch('/Doctor/Details/' + id)
            .then(res => res.text())
            .then(data => {
                document.getElementById('modalContent').innerHTML = data;
            });
    }

    // ✅ EDIT
    function openEditPopup(id) {

        var modal = new bootstrap.Modal(document.getElementById('commonModal'));
        modal.show();

        fetch('/Doctor/Edit/' + id)
            .then(res => res.text())
            .then(data => {
                document.getElementById('modalContent').innerHTML = data;
            });
    }

    // ✅ PATIENT HISTORY
    function openHealthHistory() {

        var modal = new bootstrap.Modal(document.getElementById('commonModal'));
        modal.show();

        fetch('/HealthRecord/PatientHistory')
            .then(res => res.text())
            .then(data => {
                document.getElementById('modalContent').innerHTML = data;
            });
    }

    // ✅ ADD HEALTH RECORD
    function openAddHealthRecord() {

        var modal = new bootstrap.Modal(document.getElementById('commonModal'));
        modal.show();

        fetch('/HealthRecord/Create')
            .then(res => res.text())
            .then(data => {
                document.getElementById('modalContent').innerHTML = data;
            });
    }

    // ✅ ACTIVATE / DEACTIVATE
    function confirmStatusChange(id, isActive) {

        var modal = new bootstrap.Modal(document.getElementById('confirmModal'));

        let actionText = isActive === 'True'
            ? "deactivate this doctor"
            : "activate this doctor";

        document.querySelector("#confirmModal .modal-body").innerHTML =
            "Are you sure you want to " + actionText + "?";

        document.getElementById("confirmBtn").href =
            "/Doctor/ChangeStatus/" + id;

        modal.show();
    }

    // ✅ CLOSE MODAL (common for all)
    document.addEventListener("click", function (e) {
        if (e.target.closest(".close-doctor-modal")) {
            var modalEl = document.getElementById('commonModal');
            var modal = bootstrap.Modal.getInstance(modalEl);
            modal.hide();
        }
    });

</script>
