@using System.Linq
@model IEnumerable<SharedDto.PatientDtos.PatientDto>

@{
    ViewBag.Title = "Patients";
}

<div class="container patient-container">

    <div class="page-header-section">
        <h1 class="page-title">Patient Management</h1>
        <p class="page-subtitle">View, add, edit and manage patient records.</p>
    </div>

    <div class="action-bar">
        <a href="@Url.Action("Create", "Patient")"
           class="btn custom-btn patient-btn">
            + Add New Patient
        </a>

        <a href="@Url.Action("PatientSearch", "Patient")"
           class="btn custom-btn search-btn">
            Search Patient
        </a>
    </div>

    <div class="card table-card">
        <div class="card-body">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table custom-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Date of Birth</th>
                                <th>Gender</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Insurance ID</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.FullName</td>
                                    <td>@item.DateOfBirth.ToString("dd MMM yyyy")</td>
                                    <td>@item.Gender</td>
                                    <td>@item.Email</td>
                                    <td>@item.PhoneNumber</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.InsuranceId))
                                        {
                                            @item.InsuranceId
                                        }
                                        else
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        <button type="button"
                                                class="btn btn-sm view-btn open-view-modal"
                                                data-id="@item.PatientId">
                                            View
                                        </button>

                                        <button type="button"
                                                class="btn btn-sm edit-btn open-edit-modal"
                                                data-id="@item.PatientId">
                                            Edit
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">🧑‍🤝‍🧑</div>
                    <h3>No Patients Found</h3>
                    <p>Start by adding your first patient record.</p>

                    <a href="@Url.Action("Create", "Patient")"
                       class="btn custom-btn patient-btn">
                        Add Patient
                    </a>
                </div>
            }

        </div>
    </div>

    <div class="back-link">
        <a href="@Url.Action("Index", "Home")">← Back to Home</a>
    </div>

</div>

<div class="modal fade" id="patientModal" tabindex="-1" role="dialog" aria-labelledby="patientModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content" id="patientModalContent">
        </div>
    </div>
</div>

<style>
    body {
        background: #f4fbfc;
    }

    .patient-container {
        margin-top: 45px;
        margin-bottom: 50px;
    }

    .page-header-section {
        text-align: center;
        margin-bottom: 30px;
    }

    .page-title {
        font-weight: 800;
        color: #123c4a;
        font-size: 2.4rem;
        margin-bottom: 8px;
    }

    .page-subtitle {
        color: #6c7f86;
        font-size: 1rem;
    }

    .action-bar {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-bottom: 22px;
        flex-wrap: wrap;
    }

    .table-card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
        background: #ffffff;
    }

        .table-card .card-body {
            padding: 25px;
        }

    .custom-table {
        margin-bottom: 0;
    }

        .custom-table thead {
            background: #e8f8f3;
            color: #123c4a;
        }

        .custom-table th {
            border-bottom: none;
            padding: 14px;
            font-weight: 700;
        }

        .custom-table td {
            padding: 14px;
            vertical-align: middle;
            color: #37545c;
        }

        .custom-table tbody tr:hover {
            background: #f7fcfd;
        }

    .custom-btn {
        padding: 10px 20px;
        border-radius: 25px;
        font-weight: 600;
        color: #ffffff;
        border: none;
        text-decoration: none;
        display: inline-block;
    }

        .custom-btn:hover {
            color: #ffffff;
            text-decoration: none;
        }

    .patient-btn {
        background-color: #38a889;
    }

        .patient-btn:hover {
            background-color: #2d8c72;
        }

    .search-btn {
        background-color: #f5b041;
    }

        .search-btn:hover {
            background-color: #e09a2d;
        }

    .view-btn {
        background: #4a90c2;
        color: white;
        border-radius: 18px;
        padding: 6px 14px;
        margin-right: 5px;
        border: none;
    }

        .view-btn:hover,
        .view-btn:focus {
            background: #357aa3;
            color: white;
        }

    .edit-btn {
        background: #38a889;
        color: white;
        border-radius: 18px;
        padding: 6px 14px;
        border: none;
    }

        .edit-btn:hover,
        .edit-btn:focus {
            background: #2d8c72;
            color: white;
        }

    .empty-state {
        text-align: center;
        padding: 50px 20px;
        color: #6c7f86;
    }

    .empty-icon {
        font-size: 60px;
        margin-bottom: 15px;
    }

    .empty-state h3 {
        color: #123c4a;
        font-weight: 700;
    }

    .back-link {
        margin-top: 25px;
        text-align: center;
    }

        .back-link a {
            color: #38a889;
            font-weight: 600;
            text-decoration: none;
        }

            .back-link a:hover {
                text-decoration: underline;
            }

    .modal-content {
        border: none;
        border-radius: 18px;
        overflow: hidden;
    }

    .custom-modal-header {
        background: #e8f8f3;
        color: #123c4a;
        border-bottom: none;
    }

        .custom-modal-header .modal-title {
            font-weight: 800;
        }

    .modal-profile-header {
        text-align: center;
        margin-bottom: 25px;
    }

    .modal-profile-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 12px;
        border-radius: 50%;
        background: #e8f8f3;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 36px;
    }

    .modal-profile-header h3 {
        color: #123c4a;
        font-weight: 800;
        margin-bottom: 5px;
    }

    .modal-profile-header p {
        color: #6c7f86;
    }

    .modal-details-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 15px;
    }

    .detail-item {
        background: #f7fcfd;
        border-radius: 14px;
        padding: 15px;
        border: 1px solid #e3f0f2;
    }

    .detail-label {
        display: block;
        color: #6c7f86;
        font-size: 0.9rem;
        margin-bottom: 6px;
        font-weight: 600;
    }

    .detail-value {
        color: #123c4a;
        font-size: 1rem;
        font-weight: 700;
        word-break: break-word;
    }

    .custom-input {
        height: 45px;
        border-radius: 12px;
        border: 1px solid #d7e7ea;
        box-shadow: none;
    }

        .custom-input:focus {
            border-color: #38a889;
            box-shadow: 0 0 0 0.15rem rgba(56, 168, 137, 0.15);
        }

    .modal-footer .custom-btn {
        margin-left: 5px;
    }

    .cancel-btn {
        background-color: #6c7f86;
    }

        .cancel-btn:hover {
            background-color: #53666d;
        }

    .validation-summary {
        margin-bottom: 15px;
    }

    @@media (max-width: 768px) {
        .page-title {
            font-size: 2rem;
        }

        .action-bar {
            justify-content: center;
        }

        .custom-table {
            font-size: 0.9rem;
        }

        .modal-details-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

@section Scripts {

    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(document).ready(function () {

            $(".open-view-modal").click(function () {

                var patientId = $(this).data("id");

                $("#patientModalContent").html(
                    "<div class='modal-body text-center'><h4>Loading...</h4></div>"
                );

                $("#patientModal").modal("show");

                $.get("@Url.Action("DetailsPartial", "Patient")",
                    { id: patientId },
                    function (data) {
                        $("#patientModalContent").html(data);
                    }
                );
            });

            $(".open-edit-modal").click(function () {

                var patientId = $(this).data("id");

                $("#patientModalContent").html(
                    "<div class='modal-body text-center'><h4>Loading...</h4></div>"
                );

                $("#patientModal").modal("show");

                $.get("@Url.Action("EditPartial", "Patient")",
                    { id: patientId },
                    function (data) {
                        $("#patientModalContent").html(data);

                        if ($.validator && $.validator.unobtrusive) {
                            $.validator.unobtrusive.parse("#patientEditForm");
                        }
                    }
                );
            });

            $(document).on("submit", "#patientEditForm", function (e) {

                e.preventDefault();

                var form = $(this);

                $.ajax({
                    url: form.attr("action"),
                    type: "POST",
                    data: form.serialize(),
                    success: function (response) {

                        if (response.success) {
                            $("#patientModal").modal("hide");
                            location.reload();
                        }
                        else {
                            $("#patientModalContent").html(response);

                            if ($.validator && $.validator.unobtrusive) {
                                $.validator.unobtrusive.parse("#patientEditForm");
                            }
                        }
                    },
                    error: function () {
                        $("#patientModalContent").prepend(
                            "<div class='alert alert-danger' style='margin:15px;'>Something went wrong while updating patient.</div>"
                        );
                    }
                });

            });

        });
    </script>
}